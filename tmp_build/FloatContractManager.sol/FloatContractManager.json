esses\",\"type\":\"address[]\"}],\"name\":\"setAddresses\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"name\":\"transferOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"author\":\"TB_Contracts Team\",\"custom:last-updated\":\"2025-09-05 \",\"custom:version\":\"1.0.0\",\"details\":\"This contract serves as the central hub for storing and retrieving      addresses of all protocol contracts. It provides a single source of      truth for contract addresses and allows for easy updates when contracts      are upgraded or redeployed.\",\"errors\":{\"OwnableInvalidOwner(address)\":[{\"details\":\"The owner is not a valid owner account. (eg. `address(0)`)\"}],\"OwnableUnauthorizedAccount(address)\":[{\"details\":\"The caller account is not authorized to perform an operation.\"}]},\"kind\":\"dev\",\"methods\":{\"changeStrategyAsset(address)\":{\"details\":\"Gets pool address from Uniswap V3 factory for new asset / WETH pair, then calls changeAsset on StrategyThen calls updateAsset() on Vault and SwapRouter to update their referencesOnly callable by the owner or Demeter\"},\"constructor\":{\"details\":\"Sets the deployer as the owner of the contract\"},\"deleteAddress(string)\":{\"details\":\"Sets the address to address(0) and emits an AddressDeleted event.\",\"params\":{\"_name\":\"The name of the contract whose address should be deleted.\"}},\"getAddress(string)\":{\"params\":{\"_name\":\"The name of the contract whose address is being requested.\"},\"returns\":{\"_0\":\"The address associated with the given name, or address(0) if not set.\"}},\"getAddresses(string[])\":{\"params\":{\"_names\":\"Array of contract names to get addresses for.\"},\"returns\":{\"_0\":\"Array of addresses corresponding to the names.\"}},\"isAddressSet(string)\":{\"params\":{\"_name\":\"The name of the contract to check.\"},\"returns